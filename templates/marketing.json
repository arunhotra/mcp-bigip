{
  "class": "AS3",
  "action": "deploy",
  "persist": true,
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.0.0",
    "{{TENANT_NAME}}": {
      "class": "Tenant",
      "{{APP_NAME}}": {
        "class": "Application",
        "service": {
          "class": "Service_HTTP",
          "virtualAddresses": [
            "{{VIRTUAL_IP}}"
          ],
          "pool": "web_pool"
        },
        "web_pool": {
          "class": "Pool",
          "monitors": [
            "http"
          ],
          "members": [
            {
              "servicePort": 80,
              "serverAddresses": [
                "{{POOL_MEMBER_1}}",
                "{{POOL_MEMBER_2}}"
              ]
            }
          ]
        }
      }
    }
  }
}
